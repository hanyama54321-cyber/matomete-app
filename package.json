{
  "name": "matomete-app",
  "private": true,
  "version": "1.0.0",
  "description": "安全配送まとめてアプリ - Firestoreセキュリティルールのテスト用ツールチェーン",
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore \"node --test test/rules/reports.test.js test/rules/users.test.js\"",
    "emulators": "firebase emulators:start --only firestore"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase-tools": "^15.23.0"
  }
}
