rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // 疑似メールの@より前 = 乗務員コード
    // Firebase Authはメールを小文字で保存するため、正準形(大文字)に揃える
    function myCode() {
      return request.auth.token.email.split('@')[0].upper();
    }

    // admin判定: 自分のusersドキュメントのroleをget()で参照
    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(myCode())).data.role == 'admin';
    }

    match /users/{code} {
      // 本人 or admin は個別取得可
      allow get: if isSignedIn() && (myCode() == code || isAdmin());
      // 一覧取得はadminのみ(ユーザー管理画面用)
      allow list: if isAdmin();
      // 本人は passwordChanged フィールドのみ更新可(role等は変更不可)
      // adminは全フィールド更新可(役割変更用)
      allow update: if isAdmin()
        || (myCode() == code
            && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['passwordChanged']));
      // 作成・削除はadminのみ(CSV一括投入もこの権限で通る)
      allow create, delete: if isAdmin();
    }

    match /announcements/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // 上記以外のコレクションはデフォルト拒否(明示不要だが漏れ防止)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
